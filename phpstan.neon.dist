includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 6
    paths:
        - backend/app
    scanFiles:
        - tests/stubs/wp-cli.php
    bootstrapFiles:
        - tests/bootstrap-unit.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
