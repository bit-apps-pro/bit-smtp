[
    {
        "key": "other_smtp",
        "label": "Other SMTP",
        "kind": "smtp",
        "supports_webhook": false,
        "supports_webhook_provisioning": false,
        "fields": [
            {
                "key": "host",
                "label": "SMTP server",
                "type": "text",
                "required": true,
                "secret": false,
                "placeholder": "smtp.example.com",
                "default": "",
                "options": [],
                "dependsOn": null,
                "help": {
                    "text": "Your email host's outgoing mail server, for example smtp.gmail.com."
                }
            },
            {
                "key": "encryption",
                "label": "Security",
                "type": "select",
                "required": true,
                "secret": false,
                "placeholder": "",
                "default": "tls",
                "options": [
                    {
                        "value": "tls",
                        "label": "STARTTLS (port 587, recommended)"
                    },
                    {
                        "value": "ssl",
                        "label": "SSL/TLS (port 465)"
                    },
                    {
                        "value": "none",
                        "label": "None (port 25, not encrypted)"
                    }
                ],
                "dependsOn": null,
                "autoSet": {
                    "field": "port",
                    "values": {
                        "tls": 587,
                        "ssl": 465,
                        "none": 25
                    }
                },
                "help": {
                    "text": "Encrypts the connection. Pick STARTTLS unless your host tells you otherwise.",
                    "url": "https://datatracker.ietf.org/doc/html/rfc8314",
                    "linkLabel": "Which port should I use?"
                }
            },
            {
                "key": "port",
                "label": "Port",
                "type": "number",
                "required": true,
                "secret": false,
                "placeholder": "",
                "default": 587,
                "options": [],
                "dependsOn": null,
                "help": {
                    "text": "Filled in from Security. Change it only if your host tells you to."
                }
            },
            {
                "key": "auth",
                "label": "My server requires a login",
                "type": "switch",
                "required": false,
                "secret": false,
                "placeholder": "",
                "default": true,
                "options": [],
                "dependsOn": null,
                "help": {
                    "text": "Keep this on unless your host lets this server send without a password."
                }
            },
            {
                "key": "username",
                "label": "Username",
                "type": "text",
                "required": false,
                "secret": false,
                "placeholder": "",
                "default": "",
                "options": [],
                "dependsOn": {
                    "field": "auth",
                    "value": true
                },
                "requiredWhen": {
                    "field": "auth",
                    "value": true
                },
                "help": {
                    "text": "Usually your full email address."
                }
            },
            {
                "key": "password",
                "label": "Password",
                "type": "password",
                "required": false,
                "secret": true,
                "placeholder": "",
                "default": "",
                "options": [],
                "dependsOn": {
                    "field": "auth",
                    "value": true
                },
                "requiredWhen": {
                    "field": "auth",
                    "value": true
                },
                "help": {
                    "text": "Use 2-step sign-in, like Gmail? Paste an app password instead.",
                    "url": "https://support.google.com/accounts/answer/185833",
                    "linkLabel": "Create a Google app password"
                }
            }
        ],
        "group": "mailbox",
        "bestFor": "Sending through a mailbox or mail server you already use.",
        "fromEmailHint": "Use the address you log in with, or one your mail host lets you send as.",
        "prerequisites": [
            {
                "id": "smtp_details",
                "title": "Get your SMTP settings",
                "body": "Find the server name, port and security type in your email host's setup guide."
            },
            {
                "id": "app_password",
                "title": "Create an app password if you use 2-step verification",
                "body": "Hosts such as Google need an app password instead of your normal password when 2-step verification is on.",
                "docUrl": "https://support.google.com/accounts/answer/185833"
            }
        ]
    },
