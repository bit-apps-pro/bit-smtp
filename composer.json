{
  "name": "bitapps/bit-smtp",
  "description": "SMTP Configuration plugin by Bit Apps",
  "license": "gpl-2",
  "require": {
    "php": ">=8.1",
    "bitapps/wp-validator": "^1.2.1",
    "bitapps/wp-kit": "dev-feat/static-router#586152324d8e8fd27e75170d23be7e439cbfc1f8",
    "bitapps/wp-database": "^2.0.1",
    "typisttech/imposter-plugin": "^0.6.2",
    "bitapps/wp-telemetry": "^0.0.9"
  },
  "autoload": {
    "psr-4": {
      "BitApps\\SMTP\\": "./backend/app"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BitApps\\SMTP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "lint:bootstrap": "bash bin/lint-bootstrap-syntax.sh",
    "unused:variable": "phpcs -p --standard=VariableAnalysis backend",
    "compat": "./vendor/bin/phpcs -p ./backend --standard=PHPCompatibilityWP --runtime-set testVersion 8.1-",
    "compat:gate": "./vendor/bin/phpcs -p ./bit_smtp.php ./backend/bootstrap.php --standard=PHPCompatibilityWP --runtime-set testVersion 8.0-",
    "test:unit": "./vendor/bin/phpunit -c phpunit.xml.dist",
    "test:integration": "./vendor/bin/phpunit -c phpunit.integration.xml",
    "analyse": "./vendor/bin/phpstan analyse --memory-limit=512M",
    "clean": "rm -rf ./vendor && rm composer.lock"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.10",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^12",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "wp-phpunit/wp-phpunit": "^7.0",
    "yoast/phpunit-polyfills": "^4",
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "typisttech/imposter-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "imposter": {
      "namespace": "BitApps\\SMTP\\Deps\\"
    }
  }
}
