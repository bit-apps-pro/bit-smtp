{
  "name": "bit-smtp",
  "version": "1.2.3",
  "license": "ISC",
  "author": "bit-apps",
  "scripts": {
    "clean": "rimraf node_modules yarn.lock package-lock.json pnpm-lock.yaml",
    "clear-lint-cache": "eslint . --cache --cache-file eslint-cache/eslintcache",
    "dev": "vite",
    "i18n:parse-js": "npx react-gettext-parser --output ./locale.pot --config ./gettext-parser.config.js  './frontend/src/**/{*.ts,*.tsx}'",
    "i18n:json": "[ ! -d \"languages/\" ] && mkdir languages/;npx po2json locale.pot languages/bit-smtp-index-MODULE.json -f jed1.x",
    "i18n:php": "[ ! -d \"languages/\" ] && mkdir languages/;node ./bin/pot-to-php.js locale.pot languages/generatedString.php bit-smtp;wp i18n make-pot . --include='*.php' --skip-js --slug=bit-smtp --headers='{\"Last-Translator\":\"developer@bitcode.pro\",\"Language-Team\":\"support@bitapps.pro\",\"PO-Revision-Date\":\"\"}'",
    "lint": "eslint --ext .jsx --ext .js --ext .ts --ext .tsx ./frontend/src/ --fix",
    "lint:css": "stylelint frontend/**/*.{css,scss} --aei --color --fix",
    "lint:php": "composer lint",
    "compat": "composer compat",
    "preview": "vite preview",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch=true",
    "test:cover": "vitest --coverage",
    "test:php": "composer test:unit",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report tests/e2e/.report",
    "build": "tsc && vite build",
    "pretty": "npx prettier ./frontend/src --check",
    "pretty:fix": "npx prettier ./frontend/src --check --write",
    "pretty:quick": "pretty-quick --staged",
    "ts-check": "tsc",
    "pre-commit": "lefthook run pre-commit",
    "sb": "storybook dev -p 6006",
    "all:test": "pnpm ts && pnpm lint",
    "production": "composer i --no-dev && pnpm install && pnpm build && pnpm i18n:parse-js && pnpm i18n:php",
    "cert:install-ca": "mkcert -install",
    "cert:generate": "mkcert -cert-file .certs/backend.pem -key-file .certs/backend-key.pem backend.smtp.btcd-test.io mailpit.smtp.btcd-test.io"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^5.29.3",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.12",
    "immer": "^10.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@ls-lint/ls-lint": "^1.11.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.4.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/css-modules": "^1.0.5",
    "@types/jest": "^29.5.14",
    "@types/loadable__component": "^5.13.10",
    "@types/react": "^19.2.17",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.2.3",
    "@types/yaireo__tagify": "^4.27.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "@wordpress/i18n": "^4.58.0",
    "autoprefixer": "^10.4.21",
    "conventional-changelog-atom": "^2.0.8",
    "detect-port": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-scope": "^7.2.2",
    "eslint-utils": "^3.0.0",
    "eslint-visitor-keys": "^3.4.3",
    "incstr": "^1.2.3",
    "jsdom": "^21.1.2",
    "lefthook": "^1.13.6",
    "postcss-csso": "^6.0.1",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.3.1",
    "rimraf": "^5.0.10",
    "storybook": "7.6.21",
    "stylelint": "^15.11.0",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-config-standard-scss": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.6",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  }
}
